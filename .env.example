PORT=3009
# The browser app's exact origin: the only origin CORS allows, and the base of links in emails.
# Production: APP_URL=https://corn.iidesign.cloud
APP_URL=http://localhost:5173
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=corn_b
DB_PASSWORD=
DB_NAME=corn_b

# Titan mailbox. Mail is sent from SMTP_USER as "Glass Gem Farm".
# Leave SMTP_HOST empty in development to print mail to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://corn-api.iidesign.cloud/api/auth/google/callback (also add it in the Google console)
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

RATE_LIMIT_MAX=10

# Product images: the bucket stays private. Browsers PUT straight to it (needs a CORS rule allowing PUT from APP_URL)
# and the API hands out short-lived signed read links.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe (hosted Checkout). Use a restricted key (rk_...) with write access to Checkout Sessions and Customers;
# sk_ works too. Test keys (rk_test_/sk_test_) locally, live keys only in production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally: printed by `stripe listen --forward-to localhost:3009/api/stripe/webhook`.
# Production: from Dashboard > Developers > Webhooks for https://corn-api.iidesign.cloud/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
